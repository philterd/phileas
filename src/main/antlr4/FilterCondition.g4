grammar FilterCondition;

// The generated lexer, parser, and listeners in src/main/java/ai/philterd/phileas/model/conditions/parser
// are committed, not generated by the build. After changing this file, regenerate them with the ANTLR
// tool of the same version as the antlr4-runtime dependency (4.13.2):
//
//     java -cp antlr4-4.13.2-complete.jar org.antlr.v4.Tool FilterCondition.g4
//
// and copy the .java, .tokens, and .interp files it writes into that package. The tool must report no
// warnings.

@header {package ai.philterd.phileas.model.conditions.parser;}

// One or more conditions joined by "and". No rule may match the empty string: an empty lexer
// alternative makes the lexer return an endless run of zero-length tokens on input it cannot match
// (see issue #438).
expression: condition (AND condition)* EOF;

condition: (
    'population' COMPARATOR NUMBER
    | 'token' COMPARATOR WORD
    | 'type' COMPARATOR TYPE
    | 'confidence' COMPARATOR NUMBER
    | 'context' COMPARATOR WORD
    );

TYPE: (
    'PER' | 'per'
    | 'LOC' | 'loc'
    );

AND: (
    'AND'
    | 'and'
    );

COMPARATOR: (
    '>'
    | '<'
    | '<='
    | '>='
    | '=='
    | '!='
    | 'startswith'
    | 'is'
    | 'is not'
    );

NUMBER: (
        ('0'..'9')+('.' ('0'..'9')+)?
    );

WORD: '"' (~('"' | '\\' | '\r' | '\n') | '\\' ('"' | '\\'))* '"';

WS
    :   [ ]+ -> skip
    ;
